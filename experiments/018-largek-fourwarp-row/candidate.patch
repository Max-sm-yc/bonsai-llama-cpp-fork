+// Large-K one-column specialization: one warp owns each 32-block segment of
+// a row. 128 threads cover 128 K blocks in parallel; each warp accumulates
+// its strided blocks locally before four warp sums are combined.
+template <bool has_fusion, bool has_gate>
+static __global__ void mul_mat_vec_ptq1_0_pt_largek(
+        const void * vx_, const void * vy_, const ggml_cuda_mm_fusion_args_device fusion,
+        float * dst_, const int ncols_x, const int nrows_x, const int stride_row_x,
+        const int stride_col_dst) {
+    ggml_cuda_pdl_sync();
+    extern __shared__ float sums[]; // four warp sums, then four gate sums
+    const int row = blockIdx.x;
+    const int lane = threadIdx.x & (WARP_SIZE - 1);
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int bpr = ncols_x / QK_PTQ1_0;
+    const int nblk = ptq1_0_pt_nblk(ncols_x);
+    const char * ycol[1] = { (const char *) vy_ };
+    const block_ptq1_0 * bq[1];
+    float local = 0.0f, local_gate = 0.0f;
+    for (int kbx = warp * WARP_SIZE + lane; kbx < bpr; kbx += PTQ1_0_PT_THREADS) {
+        bq[0] = (const block_ptq1_0 *) vx_ + (int64_t) row * stride_row_x + kbx;
+        float dots[1][1];
+        ptq1_0_pt_block_dot<1, 1>(bq, ycol, kbx, nblk, dots);
+        local += dots[0][0];
+        if constexpr (has_gate) {
+            bq[0] = (const block_ptq1_0 *) fusion.gate + (int64_t) row * stride_row_x + kbx;
+            ptq1_0_pt_block_dot<1, 1>(bq, ycol, kbx, nblk, dots);
+            local_gate += dots[0][0];
+        }
+    }
+    local = warp_reduce_sum<WARP_SIZE>(local);
+    if constexpr (has_gate) local_gate = warp_reduce_sum<WARP_SIZE>(local_gate);
+    if (lane == 0) {
+        sums[warp] = local;
+        if constexpr (has_gate) sums[4 + warp] = local_gate;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0 && row < nrows_x) {
+        float result = (sums[0] + sums[1]) + (sums[2] + sums[3]);
+        if constexpr (has_fusion) {
+            if (fusion.x_bias) result += ((const float *) fusion.x_bias)[row];
+            if constexpr (has_gate) {
+                float gate_value = (sums[4] + sums[5]) + (sums[6] + sums[7]);
+                if (fusion.gate_bias) gate_value += ((const float *) fusion.gate_bias)[row];
+                switch (fusion.glu_op) {
+                    case GGML_GLU_OP_SWIGLU: result *= ggml_cuda_op_silu_single(gate_value); break;
+                    case GGML_GLU_OP_GEGLU: result *= ggml_cuda_op_gelu_single(gate_value); break;
+                    case GGML_GLU_OP_SWIGLU_OAI: result = ggml_cuda_op_swiglu_oai_single(gate_value, result); break;
+                    default: result *= gate_value; break;
+                }
+            }
+        }
+        dst_[row] = result;
+    }
+}
