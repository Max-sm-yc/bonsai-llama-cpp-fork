+// Experiment-only paired-output screen: one CTA owns a row from each matrix.
+// Both dots use the same planar activation and write independent destinations.
+static __global__ void mul_mat_vec_ptq1_0_pt_pair_screen(
+        const block_ptq1_0 * k_weights, const block_ptq1_0 * v_weights, const char * y,
+        float * k_dst, float * v_dst, const int k, const int rows) {
+    const int row = blockIdx.x;
+    if (row >= rows) return;
+    const int bpr = k / QK_PTQ1_0;
+    const int nblk = ptq1_0_pt_nblk(k);
+    const char * ycol[1] = { y };
+    float ksum = 0.0f;
+    float vsum = 0.0f;
+    for (int kb = threadIdx.x; kb < bpr; kb += blockDim.x) {
+        const block_ptq1_0 * kr[1] = { k_weights + (int64_t) row*bpr + kb };
+        const block_ptq1_0 * vr[1] = { v_weights + (int64_t) row*bpr + kb };
+        float kd[1][1], vd[1][1];
+        ptq1_0_pt_block_dot<1, 1>(kr, ycol, kb, nblk, kd);
+        ptq1_0_pt_block_dot<1, 1>(vr, ycol, kb, nblk, vd);
+        ksum += kd[0][0];
+        vsum += vd[0][0];
+    }
+    __shared__ float ks[PTQ1_0_PT_THREADS];
+    __shared__ float vs[PTQ1_0_PT_THREADS];
+    ks[threadIdx.x] = ksum;
+    vs[threadIdx.x] = vsum;
+    __syncthreads();
+    for (int offset = blockDim.x / 2; offset > 0; offset >>= 1) {
+        if (threadIdx.x < offset) {
+            ks[threadIdx.x] += ks[threadIdx.x + offset];
+            vs[threadIdx.x] += vs[threadIdx.x + offset];
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        k_dst[row] = ks[0];
+        v_dst[row] = vs[0];
+    }
+}
+
+static void mul_mat_vec_ptq1_0_pt_pair_screen_launch(
+        const void * k_weights, const void * v_weights, const char * y,
+        float * k_dst, float * v_dst, const int k, const int rows, cudaStream_t stream) {
+    GGML_ASSERT(k % QK_PTQ1_0 == 0 && rows > 0);
+    mul_mat_vec_ptq1_0_pt_pair_screen<<<rows, PTQ1_0_PT_THREADS, 0, stream>>>(
+        (const block_ptq1_0 *) k_weights, (const block_ptq1_0 *) v_weights, y, k_dst, v_dst, k, rows);
+}
