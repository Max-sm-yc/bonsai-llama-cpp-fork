+extern "C" void ggml_cuda_exp056_pair(
+        const void * k, const void * v, const char * y, float * kd, float * vd,
+        int n, int rows, cudaStream_t stream) {
+    mul_mat_vec_ptq1_0_pt_pair_screen_launch(k, v, y, kd, vd, n, rows, stream);
+}
+
+extern "C" void ggml_cuda_exp056_single(
+        const void * w, const char * y, float * d, int n, int rows, cudaStream_t stream) {
+    ggml_cuda_mm_fusion_args_device fusion{};
+    const int bpr = n / QK_PTQ1_0;
+    const int rpc = ptq1_0_pt_rows_per_cta(bpr, 1, rows, 1);
+    const dim3 grid((rows + rpc - 1) / rpc, 1, 1), block(PTQ1_0_PT_THREADS, 1, 1);
+    const uint3 bpr_fd = init_fastdiv_values((uint32_t) bpr);
+    const uint3 rpc_fd = init_fastdiv_values((uint32_t) rpc);
+    const size_t smem = ptq1_0_pt_smem_bytes(bpr, 1, rows, false);
+    // Same kernel specialization and geometry as the production launcher, but
+    // a raw launch so the benchmark can capture ordinary CUDA Graph nodes.
+    mul_mat_vec_ptq1_0_pt<1, 1, false, false><<<grid, block, smem, stream>>>(
+        w, y, fusion, d, n, rows, bpr, 0, rows, rpc, bpr_fd, rpc_fd, ggml_cuda_batch_invariant());
+}
