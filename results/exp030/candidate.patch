 #define PTQ1_0_PT_MAX_COLS     8    // equals MMVQ_MAX_BATCH_SIZE, checked in mmvq.cu
 #define PTQ1_0_PT_SMEM_FLOATS  4096 // 16 KiB target when choosing rows per CTA; the launch may request more for one item
 
+// Optional cache-policy screen for the aligned packed qs words only.
+#ifndef PTQ1_0_PT_QS_CACHE_POLICY
+#define PTQ1_0_PT_QS_CACHE_POLICY 1
+#endif
+
+static __device__ __forceinline__ uint32_t ptq1_0_pt_load_qs_u32(const void * p, const int i) {
+    const uint32_t * word = (const uint32_t *) p + i;
+    uint32_t value;
+#if PTQ1_0_PT_QS_CACHE_POLICY == 1
+    asm volatile("ld.global.cg.u32 %0, [%1];" : "=r"(value) : "l"(word));
+#elif PTQ1_0_PT_QS_CACHE_POLICY == 2
+    asm volatile("ld.global.cs.u32 %0, [%1];" : "=r"(value) : "l"(word));
+#else
+    value = *word;
+#endif
+    return value;
+}
+
