+static void ssm_conv_concat_f32_cuda(const float * hist, const float * cur, const float * weights,
+                                     int hist_nb1, int hist_nb2, int cur_nb1, int cur_nb2, int weights_nb1,
+                                     float * dst, int dst_nb0, int dst_nb1, int dst_nb2,
+                                     int64_t nc, int64_t nr, int64_t n_s, cudaStream_t stream) {
+    constexpr int threads = 128;
+    GGML_ASSERT(nr % threads == 0);
+    auto launch_kernel = [&](auto NC) {
+        constexpr int kNC = decltype(NC)::value;
+        const dim3 blocks(n_s, (nr + threads - 1) / threads, 1);
+        const ggml_cuda_kernel_launch_params params = ggml_cuda_kernel_launch_params(blocks, threads, 0, stream);
+        ggml_cuda_kernel_launch(ssm_conv_concat_f32<threads, kNC>, params, hist, cur, weights,
+                                hist_nb1, hist_nb2, cur_nb1, cur_nb2, weights_nb1, dst, dst_nb0, dst_nb1, dst_nb2);
+    };
+    switch (nc) {
+        case 3: launch_kernel(std::integral_constant<int, 3>{}); break;
+        case 4: launch_kernel(std::integral_constant<int, 4>{}); break;
+        case 5: launch_kernel(std::integral_constant<int, 5>{}); break;
+        case 9: launch_kernel(std::integral_constant<int, 9>{}); break;
+        case 15: launch_kernel(std::integral_constant<int, 15>{}); break;
+        default: GGML_ABORT("Only support kernel sizes 3, 4, 5, 9, 15 right now.");
+    }
+}
+
+void ggml_cuda_op_ssm_conv_concat(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * concat, ggml_tensor * silu_dst) {
+    const ggml_tensor * weights = dst->src[1];
+    const ggml_tensor * hist = concat->src[0];
+    const ggml_tensor * cur = concat->src[1];
+    GGML_ASSERT(ggml_get_op_params_i32(concat, 0) == 0);
+    GGML_ASSERT(dst->src[0] == concat && silu_dst && ggml_nelements(silu_dst) == ggml_nelements(dst));
+    GGML_ASSERT(hist->type == GGML_TYPE_F32 && cur->type == GGML_TYPE_F32 && weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(hist->ne[0] == weights->ne[0] - 1 && cur->ne[0] == 1);
+    GGML_ASSERT(hist->ne[1] == cur->ne[1] && hist->ne[2] == cur->ne[2]);
+    GGML_ASSERT(hist->nb[0] == sizeof(float) && cur->nb[0] == sizeof(float));
+    GGML_ASSERT(hist->nb[1] == hist->ne[0] * sizeof(float) && cur->nb[1] == cur->ne[0] * sizeof(float));
+    GGML_ASSERT(hist->nb[2] == hist->nb[1] * hist->ne[1] && cur->nb[2] == cur->nb[1] * cur->ne[1]);
+    GGML_ASSERT(silu_dst->ne[1] == 1 && silu_dst->ne[2] == hist->ne[2]);
+    const int64_t nc = weights->ne[0];
+    const int64_t nr = hist->ne[1];
+    auto * out = (float *) silu_dst->data;
+    ssm_conv_concat_f32_cuda((const float *) hist->data, (const float *) cur->data,
+        (const float *) weights->data, hist->nb[1], hist->nb[2], cur->nb[1], cur->nb[2], weights->nb[1],
+        out, silu_dst->nb[0], silu_dst->nb[1], silu_dst->nb[2], nc, nr, hist->ne[2], ctx.stream());
+}
