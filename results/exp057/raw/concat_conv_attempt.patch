diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 1463169..d247477 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -2,6 +2,37 @@
 #include "ssm-conv.cuh"
 #include "unary.cuh"
 
+template <size_t split_d_inner, size_t d_conv>
+static __global__ void ssm_conv_concat_f32(const float * hist_ptr, const float * cur_ptr, const float * src1_ptr,
+                                           const int hist_nb1, const int hist_nb2, const int cur_nb1, const int cur_nb2,
+                                           const int src1_nb1, float * dst_ptr, const int dst_nb0,
+                                           const int dst_nb1, const int dst_nb2) {
+    ggml_cuda_pdl_lc();
+    const int tid = threadIdx.x;
+    const int bidx = blockIdx.x;
+    const int bidy = blockIdx.y;
+    const float * hist = (const float *) ((const char *) hist_ptr + bidx * hist_nb2 + bidy * split_d_inner * hist_nb1);
+    const float * cur = (const float *) ((const char *) cur_ptr + bidx * cur_nb2 + bidy * split_d_inner * cur_nb1);
+    const float * w_block = (const float *) ((const char *) src1_ptr + bidy * split_d_inner * src1_nb1);
+    float * y_block = (float *) ((char *) dst_ptr + bidx * dst_nb2 + bidy * split_d_inner * dst_nb0);
+    const int hist_stride = hist_nb1 / sizeof(float);
+    const int cur_stride = cur_nb1 / sizeof(float);
+    const int w_stride = src1_nb1 / sizeof(float);
+    const int y_stride = dst_nb1 / sizeof(float);
+    float x[d_conv] = { 0.0f };
+    float w[d_conv] = { 0.0f };
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (size_t j = 0; j < d_conv; ++j) w[j] = w_block[tid * w_stride + j];
+#pragma unroll
+    for (size_t j = 0; j < d_conv - 1; ++j) x[j] = hist[tid * hist_stride + j];
+    x[d_conv - 1] = cur[tid * cur_stride];
+    float sumf = 0.0f;
+#pragma unroll
+    for (size_t j = 0; j < d_conv; ++j) sumf += x[j] * w[j];
+    y_block[tid] = ggml_cuda_op_silu_single(sumf);
+}
